{
  "version": 1,
  "repository_kind": "harness",
  "default_profile": "targeted",
  "unknown_profile": "full",
  "repository_defaults": {
    "harness": {"default_profile": "targeted", "native_commands": ["python -m pytest tests/ -q"]},
    "apps": {"default_profile": "targeted"},
    "acai-ops": {"default_profile": "full-plus-runtime"}
  },
  "mechanical_paths": ["*.md", "docs/**"],
  "targeted_paths": [".acai/skills/**", "tests/**", "scripts/**", "src/**", "app/**", "apps/**", "modules/**"],
  "full_paths": [
    "AGENTS.md",
    "CLAUDE.md",
    "HERMES.md",
    "governance/**",
    ".github/workflows/**",
    "bin/**",
    "docs/harness-governance-enforcement.md",
    "docs/governance-activation-playbook.md",
    "scripts/*governance*",
    "scripts/tier_policy.py",
    "scripts/validation_profile.py",
    "scripts/check_*pr.py",
    "scripts/check_gate_b.py"
  ],
  "full_risk_tags": ["data", "security", "auth", "secret", "new tool", "new architecture"],
  "runtime_risk_tags": ["operations", "deployment", "runtime", "destructive", "data-loss", "fleet-wide", "multi-host", "irreversible"],
  "required_suites": {
    "mechanical": ["mechanical"],
    "targeted": ["targeted"],
    "full": ["targeted", "full"],
    "full-plus-runtime": ["targeted", "full", "runtime"]
  },
  "ci_test_mode": {
    "mechanical": "success",
    "targeted": "run",
    "full": "run",
    "full-plus-runtime": "run"
  }
}
